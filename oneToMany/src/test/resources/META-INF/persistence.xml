<persistence xmlns="http://java.sun.com/xml/ns/persistence"
			 version="1.0">

	<persistence-unit name="TEST_O2M" transaction-type="RESOURCE_LOCAL">
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<!-- All persistence classes must be listed -->

		<class>entities.bidir.CompanyBD</class>
		<class>entities.bidir.EmplyeeBD</class>

		<class>entities.bidir.CompanyBD2</class>
		<class>entities.bidir.EmplyeeBD2</class>

		<class>entities.bidir.CompanyBD3</class>
		<class>entities.bidir.EmplyeeBD3</class>

		<class>entities.bidir.CompanyEB</class>
		<class>entities.bidir.EmplyeeEB</class>

		<class>entities.bidir.CompanyEB2</class>
		<class>entities.bidir.EmplyeeEB2</class>

		<class>entities.bidir.CompanyEG</class>
		<class>entities.bidir.EmplyeeEG</class>

		<class>entities.unidir.CompanyUD</class>
		<class>entities.unidir.EmployeeUD</class>

		<class>entities.unidirNonPk.CompanyUDNPK</class>
		<class>entities.unidirNonPk.EmployeeUDNPK</class>

	
		<properties>
			<property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>

			<property name="javax.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/test?serverTimezone=Europe/Zurich"/>
			<property name="javax.persistence.jdbc.user" value="test"/>
			<property name="javax.persistence.jdbc.password" value="test"/>

			<property name="hibernate.archive.autodetection" value="class"/>

			<property name="javax.persistence.schema-generation.database.action"
					  value="drop-and-create"/>
		</properties>

	</persistence-unit>

</persistence> 
